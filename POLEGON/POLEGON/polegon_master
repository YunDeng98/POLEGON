import os
import sys
import subprocess
import tskit


def tip_ages_to_ordered(tip_ages_file, ts):

    rows = []
    ncol = None
    with open(tip_ages_file) as f:
        for lineno, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            parts = line.split()
            if ncol is None:
                ncol = len(parts)
            elif len(parts) != ncol:
                raise ValueError(
                    f"tip_ages line {lineno}: inconsistent column count "
                    f"(first data line had {ncol}, this line has {len(parts)})."
                )
            rows.append((lineno, parts))

    if ncol is None:
        raise ValueError("tip_ages file contains no data lines.")
    if ncol not in (1, 2):
        raise ValueError(
            f"tip_ages file has {ncol} columns; expected 1 (ages in VCF sample order) "
            f"or 2 (name age)."
        )

    samples = list(ts.samples())
    n = len(samples)

    def _num(lineno, tok):
        try:
            return float(tok)
        except ValueError:
            raise ValueError(f"tip_ages line {lineno}: age must be a number, got: {tok!r}")

    n_dip = n // 2

    if ncol == 1:
        ages = [_num(lineno, parts[0]) for lineno, parts in rows]
        if n % 2 != 0 or len(ages) != n_dip:
            raise ValueError(
                f"tip_ages (single-column) expects one age per diploid sample "
                f"({n_dip} rows for {n} haplotypes), in VCF sample order; got {len(ages)}."
            )
        return [age for age in ages for _ in (0, 1)]

    seen = set()
    name_to_age = {}
    for lineno, parts in rows:
        name = parts[0]
        if name in seen:
            raise ValueError(f"tip_ages: duplicate name {name!r} (line {lineno}).")
        seen.add(name)
        name_to_age[name] = _num(lineno, parts[1])
    file_names = set(name_to_age)

    def _label(meta):
        return meta.decode().strip() if isinstance(meta, (bytes, bytearray)) else str(meta).strip()

    if len(name_to_age) == n:
        level = "per-haplotype"
        labels = [_label(ts.node(s).metadata) for s in samples]
    elif n % 2 == 0 and len(name_to_age) == n_dip:
        level = "per-diploid"
        labels = [
            _label(ts.individual(ts.node(s).individual).metadata)
            if ts.node(s).individual != tskit.NULL else ""
            for s in samples
        ]
    else:
        raise ValueError(
            f"tip_ages (two-column) has {len(name_to_age)} rows; expected {n} "
            f"(per-haplotype labels) or {n_dip} (per-diploid labels)."
        )

    missing_label = next((s for s, lab in zip(samples, labels) if not lab), None)
    if missing_label is not None:
        raise ValueError(
            f"tip_ages {level} matching needs tip labels, but node {missing_label} carries "
            f"none. Use the single-column format, or attach labels to the tree sequence."
        )
    label_set = set(labels)
    if file_names != label_set:
        no_row = sorted(label_set - file_names)[:5]
        no_tip = sorted(file_names - label_set)[:5]
        raise ValueError(
            f"tip_ages {level} labels do not match the tree sequence. Tree sequence labels with no row: "
            f"{no_row or 'none'}; rows matching no tip: {no_tip or 'none'}."
        )
    if level == "per-haplotype" and len(label_set) != n:
        raise ValueError(
            "tip_ages: Tree sequence has duplicate per-haplotype tip labels; cannot match uniquely."
        )
    return [name_to_age[lab] for lab in labels]


def extract_tip_ages_from_ts(ts):
    samples = list(ts.samples())
    ages = [ts.node(s).time for s in samples]
    if all(a == 0.0 for a in ages):
        return None
    return ages


def estimate_Ne(ts, m, ages_ordered=None, gen_time=None):
    pi = ts.diversity(mode='site')
    if ages_ordered is not None:
        tip_ages_gen = np.array(ages_ordered) / gen_time
        n = len(tip_ages_gen)
        i_idx, j_idx = np.triu_indices(n, k=1)
        mean_abs_diff = np.mean(np.abs(tip_ages_gen[i_idx] - tip_ages_gen[j_idx]))
    else:
        mean_abs_diff = 0.0
    Ne = pi / (2 * m) - mean_abs_diff / 2
    if Ne <= 0:
        raise ValueError(
            f"Estimated Ne is non-positive ({Ne:.1f}). "
            "Check that tip ages and mutation rate are in consistent units."
        )
    print(f"Estimated Ne: {Ne:.1f}")
    return Ne


def average_mutation_rate(mutation_map_file):
    mutation_map = np.loadtxt(mutation_map_file, delimiter=' ')
    length = 0
    mut_length = 0
    m = mutation_map.shape[0]
    for i in range(m):
        length     += mutation_map[i, 1] - mutation_map[i, 0]
        mut_length += (mutation_map[i, 1] - mutation_map[i, 0]) * mutation_map[i, 2]
    avg_m = mut_length / length
    print(f"Average mutation rate: {avg_m}.")
    return avg_m


def write_root_branches(ts):
    left = 0
    right = 0
    tree = ts.first()
    while tree.total_branch_length == 0:
        tree.next()
    left = tree.interval[0]
    root = tree.root
    root_branches = []
    for tree in ts.trees():
        if tree.total_branch_length > 0 and tree.root != root:
            right = tree.interval[0]
            root_branches.append([left, right, -1, root])
            left = tree.interval[0]
            root = tree.root
    root_branches.append([left, ts.sequence_length, -1, root])
    return np.array(root_branches)


def write_arg(ts, node_file, edge_file):
    node_time     = ts.tables.nodes.time
    branch_left   = ts.tables.edges.left
    branch_right  = ts.tables.edges.right
    branch_parent = ts.tables.edges.parent
    branch_child  = ts.tables.edges.child
    branch_table  = np.array([branch_left, branch_right, branch_parent, branch_child]).T
    root_branch_table = write_root_branches(ts)
    branch_table      = np.vstack([branch_table, root_branch_table])
    is_sample  = ((ts.tables.nodes.flags & tskit.NODE_IS_SAMPLE) != 0).astype(int)
    node_table = np.column_stack([node_time, is_sample])
    np.savetxt(node_file, node_table, fmt=['%.17e', '%d'])
    np.savetxt(edge_file, branch_table)

def write_muts(ts, mut_file):
    edges = ts.tables.edges
    child, left, right, parent = edges.child, edges.left, edges.right, edges.parent
    lower_nodes = ts.tables.mutations.node
    positions = ts.tables.sites.position[ts.tables.mutations.site]
    span = ts.sequence_length + 1
    order = np.lexsort((left, child))
    key = child[order] * span + left[order]
    j = np.searchsorted(key, lower_nodes * span + positions, side='right') - 1
    record = order[np.clip(j, 0, None)]
    on_edge = ((j >= 0) & (child[record] == lower_nodes)
               & (left[record] <= positions) & (right[record] > positions))
    mut_table = np.column_stack([positions[on_edge], lower_nodes[on_edge],
                                 parent[record[on_edge]], np.ones(on_edge.sum())])
    np.savetxt(mut_file, mut_table)

def read_ARG(node_file, edge_file):
    node_time = np.loadtxt(node_file)
    edge_span = np.loadtxt(edge_file)
    edge_span = edge_span[edge_span[:, 2] >= 0, :]
    length = max(edge_span[:, 1])
    tables     = tskit.TableCollection(sequence_length=length)
    node_table = tables.nodes
    edge_table = tables.edges

    parent_set = set(edge_span[:, 2].astype(int))
    for i, t in enumerate(node_time):
        if i not in parent_set:
            node_table.add_row(flags=tskit.NODE_IS_SAMPLE, time=t)
        else:
            node_table.add_row(time=t)

    parent_indices = np.array(edge_span[:, 2], dtype=np.int32)
    child_indices  = np.array(edge_span[:, 3], dtype=np.int32)
    edge_table.set_columns(
        left=edge_span[:, 0], right=edge_span[:, 1],
        parent=parent_indices, child=child_indices
    )
    for i in range(len(parent_indices)):
        j, k = int(parent_indices[i]), int(child_indices[i])
        if node_time[j] <= node_time[k]:
            print(j, k, node_time[j], node_time[k])
    for i in range(edge_span.shape[0]):
        if edge_span[i, 0] >= edge_span[i, 1]:
            print(edge_span[i, :])
    tables.sort()
    return tables


def read_mutation(tables, mutation_file):
    mutations = np.loadtxt(mutation_file)
    n = mutations.shape[0]
    mut_pos = -1
    site_id = 0
    for i in range(n):
        if mutations[i, 0] != mut_pos and mutations[i, 0] < tables.sequence_length:
            tables.sites.add_row(position=mutations[i, 0], ancestral_state='0')
            mut_pos = mutations[i, 0]
        site_id = tables.sites.num_rows - 1
        tables.mutations.add_row(
            site=site_id,
            node=int(mutations[i, 1]),
            derived_state=str(int(mutations[i, 3]))
        )
    return


def read_mts(node_file, branch_file, mutation_file, label_source=None):
    tables = read_ARG(node_file, branch_file)
    read_mutation(tables, mutation_file)
    tables.build_index()
    tables.compute_mutation_parents()
    if label_source is not None and tables.nodes.num_rows == label_source.num_nodes:
        src = label_source.tables

        def _dec(meta):
            return meta.decode().strip() if isinstance(meta, (bytes, bytearray)) else str(meta).strip()

        tables.individuals.metadata_schema = src.individuals.metadata_schema
        tables.individuals.set_columns(
            flags=src.individuals.flags,
            location=src.individuals.location,
            location_offset=src.individuals.location_offset,
            parents=src.individuals.parents,
            parents_offset=src.individuals.parents_offset,
            metadata=src.individuals.metadata,
            metadata_offset=src.individuals.metadata_offset,
        )

        ind_name = {ind.id: _dec(ind.metadata) for ind in label_source.individuals()
                    if _dec(ind.metadata)}
        to_generate = [
            s for s in label_source.samples()
            if int(src.nodes.individual[s]) in ind_name and not label_source.node(s).metadata
        ]

        if not to_generate:
            tables.nodes.metadata_schema = src.nodes.metadata_schema
            tables.nodes.set_columns(
                flags=tables.nodes.flags,
                time=tables.nodes.time,
                population=tables.nodes.population,
                individual=src.nodes.individual,
                metadata=src.nodes.metadata,
                metadata_offset=src.nodes.metadata_offset,
            )
        else:
            mb, mo = src.nodes.metadata, src.nodes.metadata_offset
            node_meta = [bytes(mb[mo[i]:mo[i + 1]]) for i in range(src.nodes.num_rows)]
            buckets = {}
            for s in label_source.samples():
                iid = int(src.nodes.individual[s])
                if iid in ind_name:
                    buckets.setdefault(iid, []).append(int(s))
            for iid, nodes in buckets.items():
                for k, s in enumerate(sorted(nodes)):
                    if not node_meta[s]:
                        node_meta[s] = f"{ind_name[iid]}_{k}".encode()
            tables.nodes.metadata_schema = tskit.MetadataSchema.null()
            tables.nodes.set_columns(
                flags=tables.nodes.flags,
                time=tables.nodes.time,
                population=tables.nodes.population,
                individual=src.nodes.individual,
            )
            tables.nodes.packset_metadata(node_meta)
    return tables.tree_sequence()


def _run_polegon_binary(polegon_command, work_prefix, output_prefix, label_source=None):
    print("Run POLEGON command: " + ' '.join(polegon_command))
    result = subprocess.run(polegon_command)
    if result.returncode != 0:
        print("POLEGON failed")
        return
    print("POLEGON executed successfully")
    new_node_file = f"{work_prefix}_posterior_mean_nodes.txt"
    if not os.path.exists(new_node_file):
        print(f"No posterior-mean node times produced "
              f"(skipping {output_prefix}.trees). "
              f"This is expected with -scaling_rep 0 or -no_mean.")
        return
    new_ts = read_mts(
        new_node_file,
        f"{work_prefix}_branches.txt",
        f"{work_prefix}_muts.txt",
        label_source=label_source,
    )
    new_ts.dump(output_prefix + ".trees")


def polegon_rate_workflow(m, burn_in, num_samples, thin, scaling_rep, scaling_bin, input_file,
                          output_prefix, tip_ages_file, gen_time, seed, cores, no_mean, memory_safe):
    import tempfile
    work_prefix = output_prefix
    out_dir = os.path.dirname(os.path.abspath(output_prefix)) or "."
    os.makedirs(out_dir, exist_ok=True)
    old_ts = tskit.load(input_file)
    write_arg(old_ts, f"{work_prefix}_nodes.txt", f"{work_prefix}_branches.txt")
    write_muts(old_ts, f"{work_prefix}_muts.txt")
    if tip_ages_file is not None:
        ages_ordered = tip_ages_to_ordered(tip_ages_file, old_ts)
    else:
        ages_ordered = extract_tip_ages_from_ts(old_ts)
        if ages_ordered is not None:
            if gen_time is None:
                sys.exit("Error: -g (generation time) is required when the input tree sequence has heterochronous tip ages.")
            ages_ordered = [age * gen_time for age in ages_ordered]
    Ne = estimate_Ne(old_ts, m, ages_ordered, gen_time)
    script_dir    = os.path.dirname(os.path.realpath(__file__))
    polegon_binary = os.path.join(script_dir, 'polegon')
    polegon_command = [
        polegon_binary,
        "-m",           f"{m}",
        "-Ne",          f"{Ne}",
        "-burn_in",     f"{burn_in}",
        "-n_samples", f"{num_samples}",
        "-thin",        f"{thin}",
        "-scaling_rep", f"{scaling_rep}",
        "-scaling_bin", f"{scaling_bin}",
        "-input",       f"{work_prefix}",
        "-output",      f"{output_prefix}",
        "-seed",        f"{seed}",
        "-cores",       f"{cores}",
    ]
    if no_mean:
        polegon_command += ["-no_mean"]
    if memory_safe:
        polegon_command += ["-memory_safe"]
    tmp_tip_ages = None
    if ages_ordered is not None:
        fd, tmp_tip_ages = tempfile.mkstemp(suffix="_tip_ages.txt")
        with os.fdopen(fd, 'w') as f:
            for age in ages_ordered:
                f.write(f"{age}\n")
        polegon_command += ["-tip_ages", tmp_tip_ages, "-g", f"{gen_time}"]
    _run_polegon_binary(polegon_command, work_prefix, output_prefix, old_ts)
    if tmp_tip_ages and os.path.exists(tmp_tip_ages):
        os.remove(tmp_tip_ages)


def polegon_map_workflow(mutation_map, burn_in, num_samples, thin, scaling_rep, scaling_bin,
                         input_file, output_prefix, tip_ages_file,
                         gen_time, seed, cores, no_mean, memory_safe):
    import tempfile
    work_prefix = output_prefix
    out_dir = os.path.dirname(os.path.abspath(output_prefix)) or "."
    os.makedirs(out_dir, exist_ok=True)
    old_ts = tskit.load(input_file)
    write_arg(old_ts, f"{work_prefix}_nodes.txt", f"{work_prefix}_branches.txt")
    write_muts(old_ts, f"{work_prefix}_muts.txt")
    m  = average_mutation_rate(mutation_map)
    if tip_ages_file is not None:
        ages_ordered = tip_ages_to_ordered(tip_ages_file, old_ts)
    else:
        ages_ordered = extract_tip_ages_from_ts(old_ts)
        if ages_ordered is not None:
            if gen_time is None:
                sys.exit("Error: -g (generation time) is required when the input tree sequence has heterochronous tip ages.")
            ages_ordered = [age * gen_time for age in ages_ordered]
    Ne = estimate_Ne(old_ts, m, ages_ordered, gen_time)
    script_dir    = os.path.dirname(os.path.realpath(__file__))
    polegon_binary = os.path.join(script_dir, 'polegon')
    polegon_command = [
        polegon_binary,
        "-m_map",        f"{mutation_map}",
        "-Ne",           f"{Ne}",
        "-burn_in",      f"{burn_in}",
        "-n_samples",    f"{num_samples}",
        "-thin",         f"{thin}",
        "-scaling_rep",  f"{scaling_rep}",
        "-scaling_bin",  f"{scaling_bin}",
        "-input",        f"{work_prefix}",
        "-output",       f"{output_prefix}",
        "-seed",         f"{seed}",
        "-cores",        f"{cores}",
    ]
    if no_mean:
        polegon_command += ["-no_mean"]
    if memory_safe:
        polegon_command += ["-memory_safe"]
    tmp_tip_ages = None
    if ages_ordered is not None:
        fd, tmp_tip_ages = tempfile.mkstemp(suffix="_tip_ages.txt")
        with os.fdopen(fd, 'w') as f:
            for age in ages_ordered:
                f.write(f"{age}\n")
        polegon_command += ["-tip_ages", tmp_tip_ages, "-g", f"{gen_time}"]
    _run_polegon_binary(polegon_command, work_prefix, output_prefix, old_ts)
    if tmp_tip_ages and os.path.exists(tmp_tip_ages):
        os.remove(tmp_tip_ages)


def main():
    parser = argparse.ArgumentParser(
        description='Run POLEGON to estimate coalescent node times for an ARG with fixed topology.'
    )
    parser.add_argument('-m', type=float, required=False,
                        help='Per-bp per-generation mutation rate.')
    parser.add_argument('-m_map', type=str, required=False,
                        help='Spatially varying mutation rate map (columns: start end rate).')
    parser.add_argument('-burn_in', type=float, required=False, default=2500,
                        help='MCMC burn-in (default: 2500).')
    parser.add_argument('-n_samples', type=int, required=False, default=1000,
                        help='Posterior MCMC samples (default: 1000).')
    parser.add_argument('-scaling_rep', type=int, required=False, default=5,
                        help='ARG rescaling rounds (default: 5).')
    parser.add_argument('-scaling_bin', type=int, required=False, default=100,
                        help='Number of time bins used for ARG rescaling (default: 100).')
    parser.add_argument('-thin', type=int, required=False, default=10,
                        help='Thinning interval (default: 10).')
    parser.add_argument('-input', type=str, required=True,
                        help='Input tree sequence file (e.g. path/to/input.trees).')
    parser.add_argument('-output', type=str, required=True,
                        help='Prefix for the output .trees file.')
    parser.add_argument('-tip_ages', type=str, required=False, default=None,
                        help='Tip ages file (column count auto-detected): one column '
                             '(calendar_age_BP per haplotype, in VCF sample order) or two columns '
                             '(tip_label calendar_age_BP).')
    parser.add_argument('-g', type=float, required=False, default=None,
                        help='Generation time in years. Required when -tip_ages is provided.')
    parser.add_argument('-seed', type=int, required=False, default=42,
                        help='Random seed (default: 42).')
    parser.add_argument('-cores', type=int, required=False, default=1,
                        help='Number of CPU cores for parallel MCMC (default: 1).')
    parser.add_argument('-no_mean', action='store_true',
                        help='Skip computing and writing the posterior mean.')
    parser.add_argument('-memory_safe', action='store_true',
                        help='Stream unrescaled samples to disk during MCMC and rescale in batches. Uses O(cores x nodes) memory instead of O(samples x nodes).')

    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        sys.exit(1)

    args = parser.parse_args()

    if args.m is None and args.m_map is None:
        parser.error("At least one of '-m' or '-m_map' must be provided.")
    if args.tip_ages is not None and args.g is None:
        parser.error("-g is required when -tip_ages is provided.")

    if args.m_map is not None:
        polegon_map_workflow(
            args.m_map, args.burn_in, args.n_samples, args.thin,
            args.scaling_rep, args.scaling_bin, args.input, args.output,
            args.tip_ages, args.g, args.seed, args.cores, args.no_mean, args.memory_safe
        )
    else:
        polegon_rate_workflow(
            args.m, args.burn_in, args.n_samples, args.thin,
            args.scaling_rep, args.scaling_bin, args.input, args.output,
            args.tip_ages, args.g, args.seed, args.cores, args.no_mean, args.memory_safe
        )

if __name__ == "__main__":
    main()
