import numpy as np
import pandas as pd
import argparse
import os
import sys
import subprocess
import tskit


def tip_ages_to_ordered(tip_ages_file, ts):

    rows = []
    with open(tip_ages_file) as f:
        for lineno, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            parts = line.split()
            if len(parts) < 2:
                raise ValueError(
                    f"tip_ages line {lineno}: expected 'name age', got: {line!r}"
                )
            try:
                age = float(parts[1])
            except ValueError:
                raise ValueError(
                    f"tip_ages line {lineno}: age must be a number, got: {parts[1]!r}"
                )
            rows.append((parts[0], age))

    samples = list(ts.samples())

    if ts.num_individuals > 0:
        # Build name -> age map
        age_map = {name: age for name, age in rows}
        # Build node -> age via individual name
        node_to_age = {}
        for ind in ts.individuals():
            meta = ind.metadata
            if isinstance(meta, bytes):
                name = meta.decode().strip()
            elif isinstance(meta, str):
                name = meta.strip()
            else:
                name = str(meta).strip()
            if not name:
                raise ValueError(
                    f"Haplotype {ind.id} has no label in the tree sequence. "
                )
            if name not in age_map:
                raise ValueError(
                    f"Haplotype '{name}' (id {ind.id}) not found in tip_ages file."
                )
            age = age_map[name]
            for nid in ind.nodes:
                if ts.node(nid).is_sample:
                    node_to_age[nid] = age
        return [node_to_age[s] for s in samples]
    else:
        raise ValueError(
            "The tree sequence has no tip labels. "
            "Tip labels are required for tip age matching. "
        )


def estimate_Ne(ts, m, ages_ordered=None, gen_time=None):
    pi = ts.diversity(mode='site')
    if ages_ordered is not None:
        tip_ages_gen = np.array(ages_ordered) / gen_time
        n = len(tip_ages_gen)
        i_idx, j_idx = np.triu_indices(n, k=1)
        mean_abs_diff = np.mean(np.abs(tip_ages_gen[i_idx] - tip_ages_gen[j_idx]))
        Ne = pi / (2 * m) - mean_abs_diff / 2
        if Ne <= 0:
            raise ValueError(
                f"Heterochronous Ne yielded non-positive Ne ({Ne:.1f}). "
                "Check that tip ages and mutation rate are in consistent units."
            )
        print(f"Estimated Ne for heterochronous sampling: {Ne:.1f}")
    else:
        Ne = pi / (2 * m)
    print(f"Estimated Ne: {Ne:.1f}")
    return Ne


def average_mutation_rate(mutation_map_file):
    mutation_map = np.loadtxt(mutation_map_file, delimiter=' ')
    length = 0
    mut_length = 0
    m = mutation_map.shape[0]
    for i in range(m):
        length     += mutation_map[i, 1] - mutation_map[i, 0]
        mut_length += (mutation_map[i, 1] - mutation_map[i, 0]) * mutation_map[i, 2]
    avg_m = mut_length / length
    print(f"Average mutation rate: {avg_m}.")
    return avg_m


def write_root_branches(ts):
    left = 0
    right = 0
    tree = ts.first()
    while tree.total_branch_length == 0:
        tree.next()
    left = tree.interval[0]
    root = tree.root
    root_branches = []
    for tree in ts.trees():
        if tree.total_branch_length > 0 and tree.root != root:
            right = tree.interval[0]
            root_branches.append([left, right, -1, root])
            left = tree.interval[0]
            root = tree.root
    root_branches.append([left, ts.sequence_length, -1, root])
    return np.array(root_branches)


def write_arg(ts, node_file, edge_file):
    node_time     = ts.tables.nodes.time
    branch_left   = ts.tables.edges.left
    branch_right  = ts.tables.edges.right
    branch_parent = ts.tables.edges.parent
    branch_child  = ts.tables.edges.child
    branch_table  = np.array([branch_left, branch_right, branch_parent, branch_child]).T
    root_branch_table = write_root_branches(ts)
    branch_table      = np.vstack([branch_table, root_branch_table])
    node_table = node_time[:, np.newaxis]
    np.savetxt(node_file, node_table)
    np.savetxt(edge_file, branch_table)

def write_muts(ts, mut_file):
    positions, lower_nodes, upper_nodes, derived_states = [], [], [], []
    for tree in ts.trees():
        for s in tree.sites():
            for m in s.mutations:
                if m.node != tree.root:
                    positions.append(s.position)
                    lower_nodes.append(m.node)
                    upper_nodes.append(tree.parent(m.node))
                    derived_states.append(1)
    mut_table = np.array([positions, lower_nodes, upper_nodes, derived_states]).T
    np.savetxt(mut_file, mut_table)

def read_ARG(node_file, edge_file):
    node_time = np.loadtxt(node_file)
    edge_span = np.loadtxt(edge_file)
    edge_span = edge_span[edge_span[:, 2] >= 0, :]
    length = max(edge_span[:, 1])
    tables     = tskit.TableCollection(sequence_length=length)
    node_table = tables.nodes
    edge_table = tables.edges

    parent_set = set(edge_span[:, 2].astype(int))
    for i, t in enumerate(node_time):
        if i not in parent_set:
            node_table.add_row(flags=tskit.NODE_IS_SAMPLE, time=t)
        else:
            node_table.add_row(time=t)

    parent_indices = np.array(edge_span[:, 2], dtype=np.int32)
    child_indices  = np.array(edge_span[:, 3], dtype=np.int32)
    edge_table.set_columns(
        left=edge_span[:, 0], right=edge_span[:, 1],
        parent=parent_indices, child=child_indices
    )
    for i in range(len(parent_indices)):
        j, k = int(parent_indices[i]), int(child_indices[i])
        if node_time[j] <= node_time[k]:
            print(j, k, node_time[j], node_time[k])
    for i in range(edge_span.shape[0]):
        if edge_span[i, 0] >= edge_span[i, 1]:
            print(edge_span[i, :])
    tables.sort()
    return tables


def read_mutation(tables, mutation_file):
    mutations = np.loadtxt(mutation_file)
    n = mutations.shape[0]
    mut_pos = -1
    site_id = 0
    for i in range(n):
        if mutations[i, 0] != mut_pos and mutations[i, 0] < tables.sequence_length:
            tables.sites.add_row(position=mutations[i, 0], ancestral_state='0')
            mut_pos = mutations[i, 0]
        site_id = tables.sites.num_rows - 1
        tables.mutations.add_row(
            site=site_id,
            node=int(mutations[i, 1]),
            derived_state=str(int(mutations[i, 3]))
        )
    return


def read_mts(node_file, branch_file, mutation_file):
    tables = read_ARG(node_file, branch_file)
    read_mutation(tables, mutation_file)
    return tables.tree_sequence()


def _run_polegon_binary(polegon_command, input_prefix, output_prefix):
    print("Run polegon command: " + ' '.join(polegon_command))
    result = subprocess.run(polegon_command, capture_output=True, text=True)
    if result.returncode == 0:
        print("polegon executed successfully")
        new_ts = read_mts(
            f"{input_prefix}_new_nodes.txt",
            f"{input_prefix}_branches.txt",
            f"{input_prefix}_muts.txt"
        )
        new_ts.dump(output_prefix + ".trees")
    else:
        print("polegon failed")
        print(result.stderr)


def polegon_rate_workflow(m, burn_in, num_samples, thin, scaling_rep, input_prefix,
                          output_prefix, max_step, tip_ages_file, gen_time, seed):
    import tempfile
    old_ts = tskit.load(input_prefix + ".trees")
    write_arg(old_ts, f"{input_prefix}_nodes.txt", f"{input_prefix}_branches.txt")
    write_muts(old_ts, f"{input_prefix}_muts.txt")
    ages_ordered = tip_ages_to_ordered(tip_ages_file, old_ts) if tip_ages_file is not None else None
    Ne = estimate_Ne(old_ts, m, ages_ordered, gen_time)
    script_dir    = os.path.dirname(os.path.realpath(__file__))
    polegon_binary = os.path.join(script_dir, 'polegon')
    polegon_command = [
        polegon_binary,
        "-m",           f"{m}",
        "-Ne",          f"{Ne}",
        "-burn_in",     f"{burn_in}",
        "-num_samples", f"{num_samples}",
        "-thin",        f"{thin}",
        "-scaling_rep", f"{scaling_rep}",
        "-input",       f"{input_prefix}",
        "-output",      f"{output_prefix}",
        "-max_step",    f"{max_step}",
        "-seed",        f"{seed}",
    ]
    tmp_tip_ages = None
    if ages_ordered is not None:
        fd, tmp_tip_ages = tempfile.mkstemp(suffix="_tip_ages.txt")
        with os.fdopen(fd, 'w') as f:
            for age in ages_ordered:
                f.write(f"{age}\n")
        polegon_command += ["-tip_ages", tmp_tip_ages, "-g", f"{gen_time}"]
    _run_polegon_binary(polegon_command, input_prefix, output_prefix)
    if tmp_tip_ages and os.path.exists(tmp_tip_ages):
        os.remove(tmp_tip_ages)


def polegon_map_workflow(mutation_map, burn_in, num_samples, thin, scaling_rep,
                         input_prefix, output_prefix, max_step, tip_ages_file,
                         gen_time, seed):
    import tempfile
    old_ts = tskit.load(input_prefix + ".trees")
    write_arg(old_ts, f"{input_prefix}_nodes.txt", f"{input_prefix}_branches.txt")
    write_muts(old_ts, f"{input_prefix}_muts.txt")
    m  = average_mutation_rate(mutation_map)
    ages_ordered = tip_ages_to_ordered(tip_ages_file, old_ts) if tip_ages_file is not None else None
    Ne = estimate_Ne(old_ts, m, ages_ordered, gen_time)
    script_dir    = os.path.dirname(os.path.realpath(__file__))
    polegon_binary = os.path.join(script_dir, 'polegon')
    polegon_command = [
        polegon_binary,
        "-mutation_map", f"{mutation_map}",
        "-Ne",           f"{Ne}",
        "-burn_in",      f"{burn_in}",
        "-num_samples",  f"{num_samples}",
        "-thin",         f"{thin}",
        "-scaling_rep",  f"{scaling_rep}",
        "-input",        f"{input_prefix}",
        "-output",       f"{output_prefix}",
        "-max_step",     f"{max_step}",
        "-seed",         f"{seed}",
    ]
    tmp_tip_ages = None
    if ages_ordered is not None:
        fd, tmp_tip_ages = tempfile.mkstemp(suffix="_tip_ages.txt")
        with os.fdopen(fd, 'w') as f:
            for age in ages_ordered:
                f.write(f"{age}\n")
        polegon_command += ["-tip_ages", tmp_tip_ages, "-g", f"{gen_time}"]
    _run_polegon_binary(polegon_command, input_prefix, output_prefix)
    if tmp_tip_ages and os.path.exists(tmp_tip_ages):
        os.remove(tmp_tip_ages)


def main():
    parser = argparse.ArgumentParser(
        description='Run POLEGON to estimate coalescent node times for an ARG with fixed topology.'
    )
    parser.add_argument('-m', type=float, required=False,
                        help='Per-bp per-generation mutation rate.')
    parser.add_argument('-mutation_map', type=str, required=False,
                        help='Spatially varying mutation rate map (columns: start end rate).')
    parser.add_argument('-burn_in', type=float, required=False, default=100,
                        help='MCMC burn-in sweeps (default: 100).')
    parser.add_argument('-num_samples', type=int, required=False, default=100,
                        help='Posterior MCMC samples (default: 100).')
    parser.add_argument('-scaling_rep', type=int, required=False, default=3,
                        help='Scaler recalibration rounds (default: 3).')
    parser.add_argument('-thin', type=int, required=False, default=10,
                        help='Thinning interval between recorded samples (default: 10).')
    parser.add_argument('-input', type=str, required=True,
                        help='Prefix of the input .trees file.')
    parser.add_argument('-output', type=str, required=True,
                        help='Prefix for the output .trees file.')
    parser.add_argument('-max_step', type=float, required=False, default=10,
                        help='Max root node proposal size in coalescent units (default: 10).')
    parser.add_argument('-tip_ages', type=str, required=False, default=None,
                        help='Two-column file of sample ages: haplotype_name calendar_age_BP. '
                             'One row per individual (matched by tip labels in input tree sequence file)')
    parser.add_argument('-g', type=float, required=False, default=None,
                        help='Generation time in years. Required when -tip_ages is provided.')
    parser.add_argument('-seed', type=int, required=False, default=42,
                        help='Random seed (default: 42).')

    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        sys.exit(1)

    args = parser.parse_args()

    if args.m is None and args.mutation_map is None:
        parser.error("At least one of '-m' or '-mutation_map' must be provided.")
    if args.tip_ages is not None and args.g is None:
        parser.error("-g is required when -tip_ages is provided.")

    if args.mutation_map is not None:
        polegon_map_workflow(
            args.mutation_map, args.burn_in, args.num_samples, args.thin,
            args.scaling_rep, args.input, args.output, args.max_step,
            args.tip_ages, args.g, args.seed
        )
    else:
        polegon_rate_workflow(
            args.m, args.burn_in, args.num_samples, args.thin,
            args.scaling_rep, args.input, args.output, args.max_step,
            args.tip_ages, args.g, args.seed
        )

if __name__ == "__main__":
    main()
